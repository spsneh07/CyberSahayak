# ---- Database ----
POSTGRES_USER=cyber
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cyberassist
DATABASE_URL=postgresql+psycopg://cyber:change-me@localhost:5432/cyberassist

# ---- LLM provider: mock | openai | anthropic ----
# "openai" works with any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Ollama, LM Studio)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# ---- Embeddings: hash | openai ----
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
# Must match the vector column created by the migration (change both together)
EMBEDDING_DIM=384

# ---- RAG ----
RAG_TOP_K=5
RAG_MIN_SCORE=0.05

# ---- App ----
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
NEXT_PUBLIC_API_URL=http://localhost:8000
